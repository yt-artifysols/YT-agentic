{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash ../build.sh",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/cron" }],
  "functions": { "api/cron.py": { "maxDuration": 300 } },
  "crons": [
    { "path": "/api/cron/tick", "schedule": "0 6 * * *" },
    { "path": "/api/cron/plan", "schedule": "30 5 * * *" }
  ]
}
