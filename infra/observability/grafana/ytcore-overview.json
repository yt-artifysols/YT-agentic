{
  "uid": "ytcore-overview",
  "title": "ytcore overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "ytcore"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Queue depth by state",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_queue_depth",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Stage latency (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_stage_latency_seconds{quantile=\"p95\"}",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rework rate (7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_rework_rate",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Approval time (avg, 7d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_approval_seconds_avg",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cost per video (cents)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_cost_per_video_cents",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "YouTube quota used",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_quota_used_ratio",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Failed uploads (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_uploads_failed_1h",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Alerts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ytcore_alerts_24h",
          "refId": "A",
          "legendFormat": "{{state}}{{stage}}{{channel}}"
        }
      ]
    }
  ]
}
